{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@mifal-israel/shared-types": ["packages/shared-types/src"],
      "@mifal-israel/utils": ["packages/utils/src"],
      "@mifal-israel/api-client": ["packages/api-client/src"],
      "@mifal-israel/feature-flags": ["packages/feature-flags/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
